#!/bin/sh
# Scan staged changes for secrets before committing.
# Enable with: git config core.hooksPath .githooks
# Bypass a false positive with: git commit --no-verify (or a .gitleaksignore entry)

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks not installed (sudo apt install gitleaks); refusing to commit." >&2
    echo "pre-commit: use 'git commit --no-verify' to skip the secret scan." >&2
    exit 1
fi

# Private rules (e.g. personal details) live in an untracked config under .git/.
config=$(git rev-parse --git-path info/gitleaks.toml)
if [ -f "$config" ]; then
    exec gitleaks protect --staged --redact --no-banner --config "$config"
fi

exec gitleaks protect --staged --redact --no-banner
