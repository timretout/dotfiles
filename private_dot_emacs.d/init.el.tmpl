(use-package gptel
  :ensure t
  :bind (("C-c g g" . gptel)          ; Launch a dedicated chat buffer
         ("C-c g r" . gptel-rewrite)  ; Pop up the inline rewrite/refactor interface
         ("C-c g a" . gptel-add))      ; Add current buffer/file as context
  :config
  ;; 1. Configure Local Ollama for Gemma 4
  (setq-default
   gptel-backend (gptel-make-ollama "Ollama-Local"
                   :host "localhost:11434"
                   :stream t
                   :models '("gemma4:12b")) ; Matches your exact pulled tag
   gptel-model "gemma4:12b")                ; Sets Gemma 4 as your default model

  ;; 2. Configure Cloud Gemini (Optional Hybrid Fallback)
  ;; Simply uncomment if you want access to your Workspace cloud API keys
  ;; (gptel-make-gemini "Gemini-Cloud" :stream t)
  )

